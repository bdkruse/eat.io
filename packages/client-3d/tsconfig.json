{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@eat.io/protocol": ["../protocol/src/index.ts"],
      "@eat.io/client/*": ["../client/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "vite.config.ts"]
}
