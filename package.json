{
  "name": "eat.io",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/client-3d"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p packages/client-3d",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch packages/server/src/index.ts",
    "dev:3d": "npm run dev --workspace @eat.io/client-3d",
    "start": "tsx packages/server/src/index.ts",
    "build:server": "node scripts/build-server.mjs",
    "deploy:server": "node scripts/deploy-server.mjs",
    "accounts:seed": "tsx packages/server/scripts/seed-accounts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
